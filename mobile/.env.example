# Public API base URL for the mobile app.
# EXPO_PUBLIC_* values are embedded in the built app and readable by anyone —
# put ONLY non-secret values here. Never place JWTs, API keys, or other secrets
# in an EXPO_PUBLIC_* variable.
EXPO_PUBLIC_API_URL=https://bazarhq-api.onrender.com/v1

# Which shop's storefront the Customer tab shows (subdomain). Defaults to
# alvi-s-store when unset. Non-secret — safe as an EXPO_PUBLIC_* value.
EXPO_PUBLIC_SHOP_SUBDOMAIN=alvi-s-store
